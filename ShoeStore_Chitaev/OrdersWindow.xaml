<Window x:Class="ShoeStore_Chitaev.OrdersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ShoeStore_Chitaev"
        mc:Ignorable="d"
        Title="ООО Обувь — Заказы"
        Height="700" Width="1100"
        WindowStartupLocation="CenterOwner"
        Background="#FAFAFA"
        FontFamily="Times New Roman">

    <Window.Resources>
        <Style x:Key="ToolbarButton" TargetType="Button">
            <Setter Property="FontFamily" Value="Times New Roman"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="Black"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#00FA9A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ШАПКА -->
        <Border Grid.Row="0" Background="#7FFF00" Padding="15,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="BackButton"
                        Grid.Column="0"
                        Content="Назад"
                        Style="{StaticResource ToolbarButton}"
                        Click="BackButton_Click"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Image Source="Resources/Icon.png"
                           Height="42" Stretch="Uniform" Margin="0,0,10,0"/>
                    <TextBlock Text="Заказы"
                               FontFamily="Times New Roman" FontSize="22"
                               FontWeight="Bold" Foreground="Black"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button x:Name="AddOrderButton"
            Content="+ Добавить заказ"
            Style="{StaticResource ToolbarButton}"
            Background="#00FA9A"
            Margin="0,0,8,0"
            Click="AddOrderButton_Click"/>
                    <Button x:Name="DeleteOrderButton"
            Content="Удалить заказ"
            Style="{StaticResource ToolbarButton}"
            Background="#E5E5E5"
            Click="DeleteOrderButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- СПИСОК ЗАКАЗОВ -->
        <ListView x:Name="OrdersList"
                  Grid.Row="1"
                  Margin="15"
                  Background="Transparent"
                  BorderThickness="0"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                  MouseDoubleClick="OrdersList_MouseDoubleClick">

            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="180"/>
                        </Grid.ColumnDefinitions>

                        <!-- Левая колонка: инфо о заказе + список товаров -->
                        <Border Grid.Column="0"
                    BorderBrush="Black"
                    BorderThickness="1"
                    Padding="10,6"
                    Margin="0,0,10,0">
                            <StackPanel>

                                <!-- Артикул заказа -->
                                <TextBlock FontFamily="Times New Roman"
                               FontSize="14" FontWeight="Bold" Foreground="Black">
                        <Run Text="Артикул заказа: "/>
                        <Run Text="{Binding PickupCode}"/>
                                </TextBlock>

                                <!-- Статус заказа (выпадающий список) -->
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <TextBlock Text="Статус заказа: "
                                   FontFamily="Times New Roman"
                                   FontSize="13"
                                   Foreground="Black"
                                   VerticalAlignment="Center"
                                   Margin="0,0,6,0"/>

                                    <ComboBox ItemsSource="{Binding Order_Details}"
                                  FontFamily="Times New Roman"
                                  FontSize="13"
                                  Height="26"
                                  MinWidth="280"
                                  BorderBrush="Black"
                                  VerticalContentAlignment="Center">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Products.Article}"
                                                   FontFamily="Times New Roman"
                                                   FontSize="13"
                                                   FontWeight="Bold"
                                                   Foreground="Black"/>
                                                    <TextBlock Text=" — "
                                                   FontFamily="Times New Roman"
                                                   FontSize="13"
                                                   Foreground="Black"/>
                                                    <TextBlock Text="{Binding Products.Name}"
                                                   FontFamily="Times New Roman"
                                                   FontSize="13"
                                                   Foreground="Black"/>
                                                    <TextBlock Text="{Binding Quantity, StringFormat=  (кол-во: {0})}"
                                                   FontFamily="Times New Roman"
                                                   FontSize="13"
                                                   Foreground="#555555"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>

                                <!-- Адрес пункта выдачи -->
                                <TextBlock Margin="0,6,0,0"
                               FontFamily="Times New Roman"
                               FontSize="13" Foreground="Black">
                        <Run Text="Адрес пункта выдачи: "/>
                        <Run Text="{Binding Point.City}"/>
                        <Run Text=", "/>
                        <Run Text="{Binding Point.Street}"/>
                        <Run Text=", "/>
                        <Run Text="{Binding Point.House}"/>
                                </TextBlock>

                                <!-- Дата заказа -->
                                <TextBlock Margin="0,3,0,0"
                               FontFamily="Times New Roman"
                               FontSize="13" Foreground="Black">
                        <Run Text="Дата заказа: "/>
                        <Run Text="{Binding OrderDate, StringFormat={}{0:dd.MM.yyyy}}"/>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <!-- Правая колонка: дата доставки -->
                        <Border Grid.Column="1"
                    BorderBrush="Black"
                    BorderThickness="2"
                    Padding="10,6">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Дата доставки"
                               FontFamily="Times New Roman"
                               FontSize="13" FontWeight="Bold"
                               Foreground="Black"
                               HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding DeliveryDate, StringFormat={}{0:dd.MM.yyyy}}"
                               FontFamily="Times New Roman"
                               FontSize="15" Foreground="Black"
                               HorizontalAlignment="Center"
                               Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Window>