<Window x:Class="ShoeStore_Chitaev.MainMenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ShoeStore_Chitaev"
        mc:Ignorable="d"
        Title="ООО Обувь"
        Height="780" Width="1200"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="#FAFAFA"
        FontFamily="Times New Roman">

    <Window.Resources>
        <!-- Кнопка -->
        <Style x:Key="ToolbarButton" TargetType="Button">
            <Setter Property="FontFamily" Value="Times New Roman"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="Black"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#00FA9A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Поле поиска -->
        <Style x:Key="SearchBox" TargetType="TextBox">
            <Setter Property="FontFamily" Value="Times New Roman"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="BorderBrush" Value="Black"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- ComboBox -->
        <Style x:Key="FilterCombo" TargetType="ComboBox">
            <Setter Property="FontFamily" Value="Times New Roman"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="BorderBrush" Value="Black"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- Подписи -->
        <Style x:Key="FilterLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Times New Roman"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Шапка: выход слева, лого+название по центру, ФИО+роль и кнопки справа -->
        <Border Grid.Row="0" Background="#7FFF00" Padding="15,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button x:Name="BackButton"
            Content="Выйти из системы"
            Style="{StaticResource ToolbarButton}"
            Click="BackButton_Click"/>
                    <Button x:Name="OrdersButton"
            Content="Заказы"
            Style="{StaticResource ToolbarButton}"
            Margin="8,0,0,0"
            Click="OrdersButton_Click"/>
                </StackPanel>

                <!-- Логотип + название -->
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <Image Source="Resources/Icon.png"
                           Height="52" Stretch="Uniform" Margin="0,0,12,0"/>
                    <TextBlock Text="ООО Обувь"
                               FontFamily="Times New Roman"
                               FontSize="26"
                               FontWeight="Bold"
                               Foreground="Black"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- ФИО + роль + кнопки администратора (справа) -->
                <StackPanel Grid.Column="2"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Right">

                    <!-- ФИО и роль -->
                    <StackPanel HorizontalAlignment="Right">
                        <TextBlock x:Name="UserInfoTextBlock"
                                   FontFamily="Times New Roman"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   Foreground="Black"
                                   HorizontalAlignment="Right"/>
                        <TextBlock x:Name="RoleInfoTextBlock"
                                   FontFamily="Times New Roman"
                                   FontSize="12"
                                   Foreground="#333333"
                                   HorizontalAlignment="Right"
                                   Margin="0,2,0,0"/>
                    </StackPanel>

                    <!-- Кнопки администратора -->
                    <StackPanel x:Name="AdminButtonsPanel"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Margin="0,6,0,0">
                        <Button x:Name="AddTovarBtn"
                                Content="Добавить товар"
                                Style="{StaticResource ToolbarButton}"
                                Margin="0,0,5,0"
                                Click="AddTovarBtn_Click"/>
                        <Button x:Name="DeleteTovarBtn"
                                Content="Удалить товар"
                                Style="{StaticResource ToolbarButton}"
                                Click="DeleteTovarBtn_Click"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Панель фильтров: Поиск | Сортировка (2 кнопки) | Поставщик | Сброс -->
        <Border x:Name="FilterPanel" Grid.Row="1"
                Background="#7FFF00"
                BorderBrush="Black"
                BorderThickness="0,1,0,1"
                Padding="15,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Поиск -->
                <TextBlock Grid.Column="0" Text="Поиск:"
                           Style="{StaticResource FilterLabel}"/>
                <TextBox x:Name="SearchTextBox"
                         Grid.Column="1"
                         Style="{StaticResource SearchBox}"
                         MinWidth="200"
                         Margin="0,0,15,0"
                         TextChanged="SearchTextBox_TextChanged"/>

                <!-- Сортировка — обрамлённая группа с двумя кнопками -->
                <Border Grid.Column="2"
                        BorderBrush="Black"
                        BorderThickness="2"
                        Padding="6,3"
                        Margin="0,0,15,0">
                    <StackPanel>
                        <TextBlock Text="Сортировка (по кол-ву на складе)"
                                   FontFamily="Times New Roman"
                                   FontSize="12"
                                   Foreground="Black"
                                   HorizontalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                            <Button x:Name="SortAscButton"
                                    Content="По возрастанию"
                                    Style="{StaticResource ToolbarButton}"
                                    Margin="0,0,5,0"
                                    Click="SortAscButton_Click"/>
                            <Button x:Name="SortDescButton"
                                    Content="По убыванию"
                                    Style="{StaticResource ToolbarButton}"
                                    Click="SortDescButton_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Поставщик -->
                <TextBlock Grid.Column="3" Text="Поставщик:"
                           Style="{StaticResource FilterLabel}"/>
                <ComboBox x:Name="SupplierComboBox"
                          Grid.Column="4"
                          Style="{StaticResource FilterCombo}"
                          MinWidth="180"
                          Margin="0,0,15,0"
                          SelectionChanged="SupplierComboBox_SelectionChanged"/>

                <!-- Сброс -->
                <Button Grid.Column="5"
                        Content="Сбросить фильтры"
                        Style="{StaticResource ToolbarButton}"
                        Click="ResetFiltersButton_Click"/>
            </Grid>
        </Border>

        <!-- Список товаров -->
        <ListView x:Name="ListTovar" Grid.Row="2"
                  Margin="15,12,15,15"
                  Background="Transparent" BorderThickness="0"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                  MouseDoubleClick="ListTovar_MouseDoubleClick">

            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Margin" Value="0,0,0,10"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListViewItem">
                                <Border x:Name="Bd"
                                        Background="White"
                                        BorderBrush="Black"
                                        BorderThickness="2">
                                    <ContentPresenter/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <DataTrigger Binding="{Binding is_discount}" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#2E8B57"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding is_quantity}" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="Cyan"/>
                                    </DataTrigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListView.ItemContainerStyle>

            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="110"/>
                        </Grid.ColumnDefinitions>

                        <!-- Фото -->
                        <Border Grid.Column="0"
                                BorderBrush="Black"
                                BorderThickness="2"
                                Margin="6"
                                Background="White">
                            <Image Source="{Binding PhotoPath}"
                                   Stretch="Uniform"
                                   Margin="10"
                                   Height="150"/>
                        </Border>

                        <!-- Информация -->
                        <StackPanel Grid.Column="1"
                                    Margin="12,6,12,6"
                                    VerticalAlignment="Top">

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock Text="{Binding Categories.Name}"
                                           FontFamily="Times New Roman"
                                           FontSize="17" FontWeight="Bold" Foreground="Black"/>
                                <TextBlock Text=" | "
                                           FontFamily="Times New Roman"
                                           FontSize="17" FontWeight="Bold" Foreground="Black"/>
                                <TextBlock Text="{Binding Name}"
                                           FontFamily="Times New Roman"
                                           FontSize="17" FontWeight="Bold" Foreground="Black"/>
                                <TextBlock Text="{Binding Article, StringFormat=  (арт. {0})}"
                                           FontFamily="Times New Roman"
                                           FontSize="13" Foreground="#555555"
                                           VerticalAlignment="Center" Margin="8,3,0,0"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                <TextBlock Text="Описание товара: "
                                           FontFamily="Times New Roman" FontSize="13" Foreground="Black"/>
                                <TextBlock Text="{Binding Description}"
                                           FontFamily="Times New Roman" FontSize="13"
                                           Foreground="Black" TextWrapping="Wrap" MaxWidth="550"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                <TextBlock Text="Производитель: "
                                           FontFamily="Times New Roman" FontSize="13" Foreground="Black"/>
                                <TextBlock Text="{Binding Manufacturers.Name}"
                                           FontFamily="Times New Roman" FontSize="13" Foreground="Black"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                <TextBlock Text="Поставщик: "
                                           FontFamily="Times New Roman" FontSize="13" Foreground="Black"/>
                                <TextBlock Text="{Binding Suppliers.Name}"
                                           FontFamily="Times New Roman" FontSize="13" Foreground="Black"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                <TextBlock Text="Цена: "
                                           FontFamily="Times New Roman" FontSize="13" Foreground="Black"/>
                                <TextBlock Text="{Binding Price, StringFormat={}{0} руб.}"
                                           FontFamily="Times New Roman" FontSize="13">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="Black"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding is_on_sale}" Value="True">
                                                    <Setter Property="Foreground" Value="Red"/>
                                                    <Setter Property="TextDecorations" Value="Strikethrough"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="{Binding price_discount, StringFormat=  Новая цена: {0} руб.}"
                                           FontFamily="Times New Roman" FontSize="13"
                                           FontWeight="Bold" Foreground="Black" Margin="5,0,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding is_on_sale}" Value="False">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                <TextBlock Text="Единица измерения: "
                                           FontFamily="Times New Roman" FontSize="13" Foreground="Black"/>
                                <TextBlock Text="{Binding Unit}"
                                           FontFamily="Times New Roman" FontSize="13" Foreground="Black"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Количество на складе: "
                                           FontFamily="Times New Roman" FontSize="13" Foreground="Black"/>
                                <TextBlock Text="{Binding Stock_Quantity}"
                                           FontFamily="Times New Roman" FontSize="13" Foreground="Black"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Скидка -->
                        <Border Grid.Column="2"
                                BorderBrush="Black"
                                BorderThickness="2"
                                Margin="6"
                                Background="White">
                            <StackPanel VerticalAlignment="Center"
                                        HorizontalAlignment="Center"
                                        Margin="5">
                                <TextBlock Text="Действующая скидка"
                                           FontFamily="Times New Roman" FontSize="12"
                                           Foreground="Black" TextWrapping="Wrap" TextAlignment="Center"/>
                                <TextBlock Text="{Binding Discount, StringFormat={}{0}%}"
                                           FontFamily="Times New Roman" FontSize="24"
                                           FontWeight="Bold" Foreground="Black"
                                           HorizontalAlignment="Center" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Window>