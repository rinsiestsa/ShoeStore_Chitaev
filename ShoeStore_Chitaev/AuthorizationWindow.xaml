<Window x:Class="ShoeStore_Chitaev.AuthorizationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ShoeStore_Chitaev"
        mc:Ignorable="d"
        Title="ООО Обувь - Авторизация"
        Height="550" Width="750"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize"
        Background="White"
        FontFamily="Times New Roman">

    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Зелёная плашка с логотипом и заголовком -->
        <Border Grid.Row="0"
                Background="#7FFF00"
                Margin="20,20,20,10"
                Padding="20,15">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <Image Source="Resources/Icon.png"
                       Height="70"
                       Stretch="Uniform"
                       Margin="0,0,20,0"/>
                <TextBlock Text="Авторизация"
                           FontFamily="Times New Roman"
                           FontSize="32"
                           FontWeight="Bold"
                           Foreground="Black"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Форма авторизации -->
        <StackPanel Grid.Row="1"
                    VerticalAlignment="Top"
                    HorizontalAlignment="Center"
                    Margin="0,40,0,0"
                    Width="280">

            <!-- Логин -->
            <TextBlock Text="Логин"
                       FontFamily="Times New Roman"
                       FontSize="15"
                       Foreground="Black"/>
            <TextBox x:Name="LoginTextBox"
                     FontFamily="Times New Roman"
                     FontSize="14"
                     Height="27"
                     Padding="5,3"
                     BorderBrush="Gray"
                     BorderThickness="1"
                     Background="White"/>

            <!-- Пароль -->
            <TextBlock Text="Пароль"
                       FontFamily="Times New Roman"
                       FontSize="15"
                       Foreground="Black"
                       Margin="0,5,0,0"/>
            <PasswordBox x:Name="PasswordBox"
                         FontFamily="Times New Roman"
                         FontSize="14"
                         Height="27"
                         Padding="5,3"
                         BorderBrush="Gray"
                         BorderThickness="1"
                         Background="White"/>

            <!-- Кнопка "Войти" -->
            <Button x:Name="LoginButton"
                    Content="Войти"
                    FontFamily="Times New Roman"
                    FontSize="18"
                    Height="27"
                    Margin="0,15,0,0"
                    Background="#E5E5E5"
                    BorderBrush="Gray"
                    BorderThickness="1"
                    Cursor="Hand"
                    Click="LoginButton_Click"/>

            <!-- Кнопка "Войти как гость" -->
            <Button x:Name="GuestButton"
                    Content="Войти как гость"
                    FontFamily="Times New Roman"
                    FontSize="14"
                    Height="22"
                    Width="180"
                    Margin="0,15,0,0"
                    Background="#E5E5E5"
                    BorderBrush="Gray"
                    BorderThickness="1"
                    Cursor="Hand"
                    Click="GuestButton_Click"/>

            <!-- Сообщение об ошибке -->
            <TextBlock x:Name="ErrorMessageTextBlock"
                       FontFamily="Times New Roman"
                       FontSize="13"
                       Foreground="Red"
                       TextWrapping="Wrap"
                       HorizontalAlignment="Center"
                       Margin="0,15,0,0"/>
        </StackPanel>
    </Grid>
</Window>
