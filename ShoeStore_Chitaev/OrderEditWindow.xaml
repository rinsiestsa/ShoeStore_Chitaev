<Window x:Class="ShoeStore_Chitaev.OrderEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ShoeStore_Chitaev"
        mc:Ignorable="d"
        Title="Заказ"
        Height="700" Width="650"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanMinimize"
        Background="White"
        FontFamily="Times New Roman">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ШАПКА -->
        <Border Grid.Row="0" Background="#7FFF00" Padding="15,10">
            <TextBlock x:Name="HeaderText"
                       Text="Добавление заказа"
                       FontFamily="Times New Roman"
                       FontSize="20"
                       FontWeight="Bold"
                       Foreground="Black"
                       HorizontalAlignment="Center"/>
        </Border>

        <!-- ФОРМА -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="25,20,25,10">

                <!-- Артикул заказа -->
                <TextBlock Text="Артикул заказа (код выдачи):"
                           FontFamily="Times New Roman" FontSize="14"
                           Foreground="Black" Margin="0,0,0,5"/>
                <TextBox x:Name="PickupCodeBox"
                         FontFamily="Times New Roman" FontSize="14"
                         Height="30" Padding="6,3"
                         BorderBrush="Black" BorderThickness="1"
                         Margin="0,0,0,15"/>

                <!-- СТАТУС ЗАКАЗА -->
                <TextBlock Text="Статус заказа:"
                           FontFamily="Times New Roman" FontSize="14"
                           FontWeight="Bold"
                           Foreground="Black" Margin="0,0,0,5"/>
                <ComboBox x:Name="StatusComboBox"
                          FontFamily="Times New Roman" FontSize="13"
                          Height="30"
                          BorderBrush="Black"
                          Margin="0,0,0,15"
                          DisplayMemberPath="StatusName"
                          SelectedValuePath="Status_ID"/>

                <!-- ДОБАВЛЕНИЕ ТОВАРА В ЗАКАЗ -->
                <TextBlock Text="Добавить товар в заказ:"
                           FontFamily="Times New Roman" FontSize="14"
                           FontWeight="Bold"
                           Foreground="Black" Margin="0,0,0,5"/>

                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <ComboBox x:Name="AllProductsComboBox"
                              Grid.Column="0"
                              FontFamily="Times New Roman" FontSize="13"
                              Height="30"
                              BorderBrush="Black"
                              DisplayMemberPath="Display"
                              SelectedValuePath="Product_ID"/>

                    <TextBlock Grid.Column="1" Text="Кол-во:"
                               FontFamily="Times New Roman" FontSize="13"
                               VerticalAlignment="Center"
                               Margin="10,0,5,0"/>
                    <TextBox x:Name="QuantityBox"
                             Grid.Column="2"
                             FontFamily="Times New Roman" FontSize="13"
                             Width="60" Height="30" Padding="6,3"
                             BorderBrush="Black" BorderThickness="1"
                             Text="1"
                             VerticalContentAlignment="Center"/>

                    <Button x:Name="AddProductButton"
                            Grid.Column="3"
                            Content="+ Добавить"
                            FontFamily="Times New Roman" FontSize="13"
                            Height="30" Padding="12,0"
                            Background="#00FA9A"
                            BorderBrush="Black"
                            BorderThickness="1"
                            Cursor="Hand"
                            Margin="8,0,0,0"
                            Click="AddProductButton_Click"/>
                </Grid>

                <!-- Содержимое заказа -->
                <TextBlock Text="Товары в заказе:"
                           FontFamily="Times New Roman" FontSize="14"
                           FontWeight="Bold"
                           Foreground="Black" Margin="0,0,0,5"/>
                <ListView x:Name="OrderItemsList"
                          Height="150"
                          BorderBrush="Black"
                          BorderThickness="1"
                          FontFamily="Times New Roman"
                          FontSize="13">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Артикул"
                                            DisplayMemberBinding="{Binding Products.Article}"
                                            Width="100"/>
                            <GridViewColumn Header="Наименование"
                                            DisplayMemberBinding="{Binding Products.Name}"
                                            Width="180"/>
                            <GridViewColumn Header="Кол-во"
                                            DisplayMemberBinding="{Binding Quantity}"
                                            Width="70"/>
                        </GridView>
                    </ListView.View>
                </ListView>

                <Button x:Name="RemoveProductButton"
                        Content="Удалить выбранный товар"
                        FontFamily="Times New Roman" FontSize="13"
                        Height="30" Padding="12,0"
                        Background="#E5E5E5"
                        BorderBrush="Black"
                        BorderThickness="1"
                        Cursor="Hand"
                        HorizontalAlignment="Left"
                        Margin="0,8,0,15"
                        Click="RemoveProductButton_Click"/>

                <!-- Адрес пункта выдачи -->
                <TextBlock Text="Адрес пункта выдачи:"
                           FontFamily="Times New Roman" FontSize="14"
                           Foreground="Black" Margin="0,0,0,5"/>
                <ComboBox x:Name="PointComboBox"
                          FontFamily="Times New Roman" FontSize="14"
                          Height="30"
                          BorderBrush="Black"
                          Margin="0,0,0,15"/>

                <!-- Дата заказа -->
                <TextBlock Text="Дата заказа:"
                           FontFamily="Times New Roman" FontSize="14"
                           Foreground="Black" Margin="0,0,0,5"/>
                <DatePicker x:Name="OrderDatePicker"
                            FontFamily="Times New Roman" FontSize="14"
                            Height="30"
                            BorderBrush="Black"
                            Margin="0,0,0,15"/>

                <!-- Дата доставки -->
                <TextBlock Text="Дата доставки:"
                           FontFamily="Times New Roman" FontSize="14"
                           Foreground="Black" Margin="0,0,0,5"/>
                <DatePicker x:Name="DeliveryDatePicker"
                            FontFamily="Times New Roman" FontSize="14"
                            Height="30"
                            BorderBrush="Black"/>

                <!-- Ошибка -->
                <TextBlock x:Name="ErrorMessage"
                           FontFamily="Times New Roman" FontSize="13"
                           Foreground="Red" TextWrapping="Wrap"
                           Margin="0,15,0,0"/>
            </StackPanel>
        </ScrollViewer>

        <!-- КНОПКИ -->
        <StackPanel Grid.Row="2" Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,0,25,20">
            <Button Content="Сохранить"
                    FontFamily="Times New Roman" FontSize="14"
                    Width="120" Height="32"
                    Background="#00FA9A"
                    BorderBrush="Black"
                    BorderThickness="1"
                    Cursor="Hand"
                    Margin="0,0,10,0"
                    Click="SaveButton_Click"/>
            <Button Content="Отмена"
                    FontFamily="Times New Roman" FontSize="14"
                    Width="100" Height="32"
                    Background="#E5E5E5"
                    BorderBrush="Black"
                    BorderThickness="1"
                    Cursor="Hand"
                    Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</Window>